{
  "name": "backend",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch index.ts",
    "worker": "bun --watch workers/index.ts",
    "db:generate": "bunx drizzle-kit generate --config config/drizzle.config.ts",
    "db:push": "bunx drizzle-kit push --config config/drizzle.config.ts",
    "db:migrate": "bunx drizzle-kit migrate --config config/drizzle.config.ts",
    "test": "vitest test"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/http-status-codes": "^1.2.0",
    "@types/pg": "^8.21.0",
    "@types/ws": "^8.18.1",
    "drizzle-kit": "^1.0.0-rc.4",
    "drizzle-orm": "^1.0.0-rc.4",
    "http-status-codes": "^2.3.0",
    "pg": "^8.23.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@aws-sdk/client-sqs": "^3.1117.0",
    "@aws-sdk/s3-request-presigner": "^3.1116.0",
    "@google/genai": "^2.19.0",
    "@types/cors": "^2.8.19",
    "@types/dotenv": "^8.2.3",
    "@types/express": "^5.0.6",
    "better-auth": "^1.6.29",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "pdf-parse": "^2.4.5",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  }
}