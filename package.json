{
  "name": "dropvault",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "backend": "workspace:*",
    "concurrently": "^10.0.5",
    "frontend": "workspace:*"
  },
  "scripts": {
    "dev": "concurrently \"bun --cwd frontend dev\" \"bun --cwd backend dev\"  \"bun --cwd backend worker\"",
    "migrate": "cd backend && bun run db:generate",
    "push_changes": "cd backend && bun run db:push"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "better-auth": "^1.6.29"
  }
}