{
  "name": "dropvault",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "backend": "workspace:*",
    "concurrently": "^10.0.5",
    "frontend": "workspace:*"
  },
  "scripts": {
    "run:frontend": "bun --cwd apps/frontend dev",
    "run:backend": "bun --cwd apps/backend dev",
    "run:worker": "bun --cwd apps/backend worker",
    "run:ai": "cd apps/ai && uv run src/main.py",
    "dev": "concurrently \"bun run run:frontend\" \"bun run run:backend\" \"bun run run:worker\" \"bun run run:ai\"",
    "migrate": "cd backend && bun run db:generate",
    "push_changes": "cd backend && bun run db:push"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "better-auth": "^1.6.29"
  }
}